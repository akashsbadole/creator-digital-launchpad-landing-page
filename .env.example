
# Creator Launch Kit Environment Variables
# Copy this file to .env.local and fill in your actual values

# =================================
# DATABASE CONFIGURATION
# =================================
DATABASE_URL=postgresql://username:password@localhost:5432/creator_launch_kit
DB_HOST=localhost
DB_PORT=5432
DB_NAME=creator_launch_kit
DB_USER=your_db_username
DB_PASSWORD=your_db_password

# =================================
# APPLICATION SETTINGS
# =================================
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
API_BASE_URL=http://localhost:3000/api
JWT_SECRET=your_super_secret_jwt_key_here_make_it_long_and_random
JWT_EXPIRES_IN=7d

# =================================
# STRIPE PAYMENT GATEWAY
# =================================
# Get these from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_51234567890abcdef...
STRIPE_PUBLISHABLE_KEY=pk_test_51234567890abcdef...
STRIPE_WEBHOOK_SECRET=whsec_1234567890abcdef...
STRIPE_SUCCESS_URL=http://localhost:3000/payment-success
STRIPE_CANCEL_URL=http://localhost:3000/payment-canceled

# =================================
# PAYPAL PAYMENT GATEWAY
# =================================
# Get these from: https://developer.paypal.com/
PAYPAL_CLIENT_ID=your_paypal_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_client_secret_here
PAYPAL_MODE=sandbox
# Set to 'live' for production
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id

# =================================
# RAZORPAY PAYMENT GATEWAY
# =================================
# Get these from: https://dashboard.razorpay.com/
RAZORPAY_KEY_ID=rzp_test_1234567890
RAZORPAY_KEY_SECRET=your_razorpay_secret_key_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# =================================
# EMAIL SERVICE - MAILCHIMP
# =================================
# Get these from: https://mailchimp.com/developer/
MAILCHIMP_API_KEY=your_mailchimp_api_key_here-us1
MAILCHIMP_LIST_ID=your_mailchimp_audience_list_id
MAILCHIMP_SERVER_PREFIX=us1
# Server prefix (us1, us2, etc.) from your API key

# =================================
# EMAIL SERVICE - SENDGRID (Alternative)
# =================================
# Get from: https://app.sendgrid.com/
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=noreply@yourdomain.com
SENDGRID_FROM_NAME=Creator Launch Kit

# =================================
# FILE STORAGE - AWS S3
# =================================
# Get these from AWS IAM Console
AWS_ACCESS_KEY_ID=AKIA1234567890ABCDEF
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_S3_BUCKET=your-digital-products-bucket
AWS_REGION=us-east-1
AWS_S3_URL=https://your-bucket.s3.amazonaws.com

# =================================
# FILE STORAGE - GOOGLE CLOUD (Alternative)
# =================================
GOOGLE_CLOUD_PROJECT_ID=your-project-id
GOOGLE_CLOUD_KEY_FILE=path/to/service-account-key.json
GOOGLE_CLOUD_BUCKET=your-gcs-bucket-name

# =================================
# DOWNLOAD SECURITY
# =================================
DOWNLOAD_BASE_URL=https://files.yourdomain.com
DOWNLOAD_TOKEN_EXPIRES=24h
# How long download links remain valid
MAX_DOWNLOADS_PER_PURCHASE=5
# Maximum downloads allowed per purchase

# =================================
# EMAIL TEMPLATES
# =================================
EMAIL_TEMPLATE_WELCOME=d-1234567890abcdef
EMAIL_TEMPLATE_PRODUCT_DELIVERY=d-abcdef1234567890
EMAIL_TEMPLATE_FOLLOW_UP=d-567890abcdef1234
EMAIL_TEMPLATE_NEWSLETTER=d-cdef1234567890ab

# =================================
# ANALYTICS & TRACKING
# =================================
GOOGLE_ANALYTICS_ID=GA_MEASUREMENT_ID
FACEBOOK_PIXEL_ID=your_facebook_pixel_id
HOTJAR_ID=your_hotjar_site_id

# =================================
# RATE LIMITING
# =================================
RATE_LIMIT_WINDOW=15
# Rate limit window in minutes
RATE_LIMIT_MAX_REQUESTS=100
# Max requests per window

# =================================
# LOGGING
# =================================
LOG_LEVEL=info
# Options: error, warn, info, debug
LOG_FILE_PATH=logs/app.log

# =================================
# CORS SETTINGS
# =================================
CORS_ORIGIN=http://localhost:3000,https://yourdomain.com
# Comma-separated list of allowed origins

# =================================
# SESSION SETTINGS
# =================================
SESSION_SECRET=your_session_secret_key_here
SESSION_EXPIRES=24h

# =================================
# WEBHOOK ENDPOINTS
# =================================
WEBHOOK_STRIPE_ENDPOINT=/api/webhooks/stripe
WEBHOOK_PAYPAL_ENDPOINT=/api/webhooks/paypal
WEBHOOK_RAZORPAY_ENDPOINT=/api/webhooks/razorpay

# =================================
# ADMIN SETTINGS
# =================================
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=your_secure_admin_password
ADMIN_JWT_SECRET=your_admin_jwt_secret_here

# =================================
# BACKUP SETTINGS
# =================================
BACKUP_FREQUENCY=daily
# Options: hourly, daily, weekly
BACKUP_RETENTION_DAYS=30
BACKUP_STORAGE_PATH=backups/

# =================================
# SSL/TLS SETTINGS (Production)
# =================================
SSL_CERT_PATH=path/to/ssl/cert.pem
SSL_KEY_PATH=path/to/ssl/private.key

# =================================
# MONITORING
# =================================
SENTRY_DSN=https://your_sentry_dsn_here
# For error tracking and monitoring

# =================================
# FEATURE FLAGS
# =================================
ENABLE_GUEST_CHECKOUT=true
ENABLE_COUPONS=true
ENABLE_REVIEWS=true
ENABLE_ANALYTICS=true
ENABLE_EMAIL_AUTOMATION=true
